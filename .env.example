# ─────────────────────────────────────────────────────────────
# NAGRIK — configuration
# Copy this file to `.env` (repo root) and fill in your keys.
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ── LLM provider ─────────────────────────────────────────────
# "openai"      -> any OpenAI-compatible API (OpenAI, Groq, Together, Ollama, LM Studio…)
LLM_PROVIDER=openai
LLM_API_KEY=
# Base URL of an OpenAI-compatible endpoint.
#   OpenAI : https://api.openai.com/v1
#   Groq   : https://api.groq.com/openai/v1
#   Ollama : http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Speech-to-text provider ───────────────────────────────────
# "local"  -> faster-whisper running on this machine (no key needed)
# "openai" -> OpenAI Whisper API (needs STT_API_KEY or LLM_API_KEY)
STT_PROVIDER=local
STT_MODEL=base            # tiny | base | small | medium (local whisper model size)
STT_API_KEY=

# ── Text-to-speech provider (optional, AI voiceover) ─────────
# "none"    -> voiceover disabled (original footage audio is used)
# "openai"  -> OpenAI TTS API
TTS_PROVIDER=none
TTS_VOICE=onyx
TTS_API_KEY=

# ── Storage ───────────────────────────────────────────────────
# MVP uses local filesystem. STORAGE_BACKEND=s3 planned; interface already abstracted.
STORAGE_BACKEND=local
DATA_DIR=./data

# ── Server ────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
MAX_UPLOAD_MB=2048

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
